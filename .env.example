TWENTY_BASE_URL=https://crm.fraterailabs.com
TWENTY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.fraterailabs.com/api/auth/google/callback
ALLOWED_GOOGLE_DOMAIN=fraterailabs.com
PORTAL_EMAIL_ALLOWLIST=
SESSION_SECRET=
TWENTY_WEBHOOK_SECRET=
HUBSPOT_PORTAL_ID=245673738
HUBSPOT_FORM_GUID=7aaf12d7-5cc8-43a9-91ce-2fcb0961ab4c
SLACK_WEBHOOK_URL=

# Cloudflare Turnstile. The site key is rendered into the browser and is
# genuinely public — NEXT_PUBLIC_ is correct for it. The secret key is NOT
# public: never prefix it with NEXT_PUBLIC_, or it ships to every visitor.
# Local dev: use Cloudflare's documented always-passing test keys instead of
# a code bypass (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Magic-link sign-in email (Task 5b), sent via Google Workspace SMTP with an
# app password. An app password has full mailbox send rights and is a
# long-lived credential — worse to hold than a scoped API key — but it adds
# no third-party vendor, which is why it was chosen anyway. Generate it at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on
# the sending account) and never commit the real value.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# The Workspace mailbox address that sends the magic-link emails.
SMTP_USER=
# The 16-character app password generated for SMTP_USER above (not the
# account's login password).
SMTP_APP_PASSWORD=
PORTAL_EMAIL_FROM=portal@fraterailabs.com

# The canonical origin used to build the link inside magic-link emails
# (app/api/auth/magic-link/request/route.ts). MUST NOT be derived from the
# incoming request: Next.js Route Handlers apply no origin allowlist (unlike
# Server Actions' serverActions.allowedOrigins), and a client can set
# X-Forwarded-Host to make request.url resolve to an attacker-controlled
# host. Since this value ends up in an email sent to a third party — not a
# redirect back to the same browser that supplied the header — a poisoned
# origin here means a genuine email, from the genuine sender, containing a
# valid token pointed at an attacker's server. Set to the real deployed
# origin, e.g. https://www.fraterailabs.com — no trailing slash.
SERVER_URL=https://www.fraterailabs.com
