# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Spreadsheets are assumed to hold real prospect data (names, titles, contact
# research) and are never committed. Pinning one exact path meant a rename or
# a second copy would sail straight into git. The only exception is the
# synthetic test fixture (Ada Lovelace / Grace Hopper), which is tracked.
*.xlsx
!scripts/import-prospects/__tests__/fixtures/mini.xlsx

# twenty-app (Twenty CRM application package)
twenty-app/node_modules
twenty-app/dist
twenty-app/.twenty
